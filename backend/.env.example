# ─── NWIS Backend — Environment Variables Template ──────────────────────────
# Copy this file to .env and populate for local development.
# On Render, set these values directly in the service's Environment tab.
# NEVER commit a .env file with real secrets to version control.

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://nwis-app.vercel.app,https://www.your-domain.com
# Leave as * for local development. ALWAYS restrict in production.
ALLOWED_ORIGINS=*

# ─── Python Runtime ──────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/app
